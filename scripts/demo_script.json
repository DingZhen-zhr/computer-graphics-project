      },
      {
       "name": "plate_w",
       "value": 60,
       "unit": "mm",
       "source": "user",
       "note": "板宽（y 方向）"
      }
     ],
     "features": [
      "板",
      "角孔，四个角上"
     ],
     "relations": [
      "角孔在板的四个角上，孔心离相邻两条边各 hole_inset，贯通板厚"
     ],
     "open_questions": [
      "板厚多少？",
